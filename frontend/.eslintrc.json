{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "plugins": [
    "react"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es6": true,
    "jest": true
  },
  "settings": {
    "react": {
      "version": "18.2.0"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}

